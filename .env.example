# Variáveis de ambiente — SiOfi Landing Page
# Referência completa: docs/siofi-landing-technical-performance-seo-tracking.md §47
#
# Convenção: PUBLIC_* é exposta ao bundle client (não é segredo).
# Qualquer variável sem esse prefixo é server-only e NUNCA deve ser referenciada
# em código que roda no client (componentes hidratados, scripts inline).

# ---- Públicas (client-safe) ----

# ID do container GTM (formato GTM-XXXXXXX)
PUBLIC_GTM_CONTAINER_ID=[TBD — FORNECER PELA F5]

# ID do stream GA4 (formato G-XXXXXXX)
PUBLIC_GA4_MEASUREMENT_ID=[TBD — FORNECER PELA F5]

# URL canônica base do site, usada para canonical/OG/sitemap absolutos
# Definido por Renato em 2026-08-26 (auditoria SEO).
PUBLIC_SITE_URL=https://f5sg.com.br

# ID do Meta Pixel (não é secreto em si; o token de acesso abaixo é que é sensível)
META_PIXEL_ID=[TBD — FORNECER PELA F5]

# ---- Secretas (server-only — nunca prefixar com PUBLIC_) ----

# Token de acesso à Graph API do Meta para chamadas server-side do CAPI
META_CAPI_ACCESS_TOKEN=[TBD — FORNECER PELA F5]

# Identificação da Conversion Action do Google Ads para Enhanced Conversions
GOOGLE_ADS_CONVERSION_ID=[TBD — FORNECER PELA F5]
GOOGLE_ADS_CONVERSION_LABEL=[TBD — FORNECER PELA F5]

# Credencial para envio server-side de Enhanced Conversions, se implementado fora do GTM
GOOGLE_ADS_ENHANCED_CONVERSIONS_API_KEY=[TBD — FORNECER PELA F5]

# Destino do lead (CRM/webhook) — endpoint e credencial
CRM_ENDPOINT=[TBD — DEFINIR CRM]
CRM_API_KEY=[TBD — DEFINIR CRM]

# Binding do armazenamento usado para rate limiting em /api/lead (ex.: KV namespace do Cloudflare)
RATE_LIMIT_KV_NAMESPACE=[TBD — CONFIGURAR NA INFRAESTRUTURA]

# Nome do campo honeypot do formulário (mantém consistência, não é segredo de alto risco)
HONEYPOT_FIELD_NAME=website_url
