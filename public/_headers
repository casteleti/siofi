# Headers HTTP — Cloudflare (spec técnica §40/§41/§42).
#
# CSP: 'unsafe-inline' em script-src é necessário para o snippet inline do
# GTM/Consent Mode stub (§41 nota MUST) — risco aceito documentado na spec,
# já que não há input de terceiros renderizado sem sanitização nesta página.
# Ajustar connect-src quando o CRM final (§34) usar domínio próprio.
# HSTS sem `preload` de propósito (§40/§41): só ativar depois de confirmar
# HTTPS em todos os subdomínios relevantes de f5sg.com.br em produção — não
# ativar só porque o domínio já foi decidido (auditoria SEO 2026-08-26);
# preload é um registro público de difícil reversão.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.facebook.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com https://graph.facebook.com; frame-src https://www.googletagmanager.com; font-src 'self'; base-uri 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: SAMEORIGIN

/siofi
  Cache-Control: public, max-age=0, must-revalidate

/siofi/obrigado
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, follow

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/screens/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/assets/og/*
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400

/sitemap-index.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
