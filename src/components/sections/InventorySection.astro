---
/**
 * Estoque e compras (Section Map §25 #8). Split 7/5 invertido, ProductFrame + checklist.
 */
import Icon from '../ui/Icon.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import Callout from '../ui/Callout.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { inventory } = copy;
---

<section id="inventory" class="section" aria-labelledby="inventory-heading">
  <div class="container split split--7-5">
    <div class="split__media reveal">
      <ProductFrame label="Estoque" ratio="16:10">
        Tela de consulta de estoque e importação de XML no SiOfi
      </ProductFrame>
      <Callout icon="file-code-2" position="top-left">Importação de XML</Callout>
    </div>

    <div>
      <h2 id="inventory-heading" class="text-h2 reveal">{inventory.headline}</h2>
      {inventory.paragraphs.map((paragraph) => <p class="text-body-lg reveal">{paragraph}</p>)}

      <ul class="inventory__checklist reveal">
        {
          inventory.benefits.map((benefit) => (
            <li>
              <Icon name="check" size={20} />
              <span>{benefit}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .split__media {
    position: relative;
  }

  .inventory__checklist {
    list-style: none;
    margin: var(--space-6) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .inventory__checklist li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-primary);
  }
</style>
