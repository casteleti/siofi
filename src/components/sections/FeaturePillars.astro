---
/**
 * Pilares do SiOfi (Section Map §25 #5, id #pilares). Grid 3×2, 6 FeatureCards com chips.
 */
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { featurePillars } = copy;
---

<section id="pilares" class="section" aria-labelledby="pilares-heading">
  <div class="container">
    <div class="section-header section-header--center">
      <span class="pilares__eyebrow reveal">
        <span class="pilares__eyebrow-dot" aria-hidden="true"></span>
        {featurePillars.eyebrow}
      </span>
      <h2 id="pilares-heading" class="text-h2 reveal">{featurePillars.headline}</h2>
      <p class="text-body-lg reveal">{featurePillars.subheadline}</p>
    </div>

    <div class="card-grid card-grid--3">
      {
        featurePillars.pillars.map((pillar, i) => (
          // CARD-04: o pilar "Gestão" (índice 2) quebra o padrão repetido de
          // ícone-acima-do-título nos outros 5 — ícone ao lado do título,
          // ainda no canto superior esquerdo do card (§10: nunca centralizado).
          <Card variant="feature" class={`reveal${i === 2 ? ' pillar-card--emphasis' : ''}`} style={`--i:${i}`}>
            <div class="pillar-card__head">
              <span class="pillar-card__icon">
                <Icon name={pillar.icon} size={28} />
              </span>
              {i === 2 && <h3 class="text-h3 pillar-card__head-title">{pillar.title}</h3>}
            </div>
            {i !== 2 && <h3 class="text-h3">{pillar.title}</h3>}
            <p class="text-body">{pillar.text}</p>
            <hr class="pillar-card__divider" />
            <ul class="pillar-card__list">
              {pillar.features.map((feature) => (
                <li>
                  <Icon name={feature.icon} size={16} />
                  <span>{feature.label}</span>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pilares__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    margin-bottom: var(--space-4);
    border-radius: var(--radius-full);
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    font: var(--weight-semibold) var(--text-xs) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
  }

  .pilares__eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .pillar-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: var(--icon-box);
    height: var(--icon-box);
    border-radius: var(--radius-md);
    background: var(--color-icon-bg);
    color: var(--color-icon);
    margin-bottom: var(--space-5);
  }

  .pillar-card__head {
    display: contents;
  }

  .pillar-card--emphasis .pillar-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-3);
  }

  .pillar-card--emphasis .pillar-card__icon {
    margin-bottom: 0;
  }

  .pillar-card__head-title {
    margin: 0;
  }

  .pillar-card__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-5) 0;
  }

  .pillar-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .pillar-card__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: var(--weight-medium) var(--text-sm) var(--font-body);
    color: var(--color-text-secondary);
  }

  .pillar-card__list :global(svg) {
    flex-shrink: 0;
    color: var(--color-primary);
  }
</style>
