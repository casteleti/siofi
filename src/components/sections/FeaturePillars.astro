---
/**
 * Pilares do SiOfi (Section Map §25 #5, id #pilares). Grid 3×2, 6 FeatureCards com chips.
 */
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import Chip from '../ui/Chip.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { featurePillars } = copy;
---

<section id="pilares" class="section" aria-labelledby="pilares-heading">
  <div class="container">
    <div class="section-header section-header--center">
      <h2 id="pilares-heading" class="text-h2 reveal">{featurePillars.headline}</h2>
    </div>

    <div class="card-grid card-grid--3">
      {
        featurePillars.pillars.map((pillar, i) => (
          <Card variant="feature" class="reveal" style={`--i:${i}`}>
            <span class="pillar-card__icon">
              <Icon name={pillar.icon} size={28} />
            </span>
            <p class="text-h3">{pillar.title}</p>
            <p class="text-body">{pillar.text}</p>
            <div class="pillar-card__chips">
              {pillar.features.map((feature) => (
                <Chip>{feature}</Chip>
              ))}
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillar-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-box);
    height: var(--icon-box);
    border-radius: var(--radius-md);
    background: var(--color-icon-bg);
    color: var(--color-icon);
    margin-bottom: var(--space-5);
  }

  .pillar-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
</style>
