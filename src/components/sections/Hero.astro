---
/**
 * Hero (Section Map §25 #1). Split 5/7, painel primary-light com ProductFrame
 * do dashboard + callouts. H1 vem de content/landing-pages (título aprovado);
 * demais textos vêm de content/copy (copy §6).
 */
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import Callout from '../ui/Callout.astro';
import copy from '../../content/copy/siofi-main.copy.json';

interface Props {
  h1: string;
}

const { h1 } = Astro.props;
const { hero } = copy;
---

<section id="hero" class="hero">
  <div class="container-wide split split--5-7">
    <div class="hero__text">
      {/* Sem .reveal no eyebrow/H1 (FX-01): o H1 é o candidato a LCP (spec técnica
          §10) e não pode nascer com opacity:0 esperando o IntersectionObserver —
          isso atrasaria a primeira impressão real da página. */}
      <p class="text-eyebrow">{hero.eyebrow}</p>
      <h1 class="text-display">{h1}</h1>
      <p class="text-sub reveal">{hero.subheadline}</p>
      <div class="hero__ctas reveal">
        <Button variant="primary" href="#form" trackId="hero_cta_click" section="hero">
          {hero.ctaPrimary}
        </Button>
        <Button variant="secondary" href="#pilares" trackId="secondary_cta_click" section="hero">
          {hero.ctaSecondary}
        </Button>
      </div>
      <p class="text-small reveal">{hero.microcopy}</p>
    </div>

    <div class="hero__media reveal">
      <ProductFrame label="Indicadores" ratio="16:10" size="lg">
        Tela de indicadores do SiOfi mostrando faturamento e resultado do período
      </ProductFrame>
      <Callout icon="bar-chart-3" position="top-right">Resultado do período</Callout>
      <Callout icon="trending-up" position="bottom-left">Faturamento</Callout>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 96px 80px;
    background: var(--color-white);
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-4);
    margin-block: var(--space-8);
  }

  .hero__media {
    position: relative;
    background: var(--color-primary-light);
    border-radius: var(--radius-xl);
    padding: var(--space-10);
  }

  @media (max-width: 767px) {
    .hero {
      padding-block: 48px 56px;
    }

    .hero__ctas {
      flex-direction: column;
    }

    .hero__ctas :global(.btn) {
      width: 100%;
    }
  }
</style>
