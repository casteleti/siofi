---
/**
 * Prova social (Section Map §25 #13, neutral-50). Grid 3, TestimonialCards.
 * Regra MUST (copy §18): apenas depoimentos reais e autorizados. Sem nenhum
 * depoimento cadastrado ainda, a seção inteira fica oculta (design system:
 * "seções condicionais ocultas quando vazias").
 */
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import copy from '../../content/copy/siofi-main.copy.json';

interface Testimonial {
  quote: string;
  name: string;
  company: string;
  location: string;
}

const { testimonials } = copy;
const items = testimonials.items as Testimonial[];
const hasTestimonials = items.length > 0;
---

{
  hasTestimonials && (
    <section id="testimonials" class="section section--alt" aria-labelledby="testimonials-heading">
      <div class="container">
        <div class="section-header section-header--center">
          <h2 id="testimonials-heading" class="text-h2 reveal">
            {testimonials.headline}
          </h2>
        </div>

        <div class="card-grid card-grid--3">
          {items.map((item, i) => (
            <Card variant="testimonial" class="reveal" style={`--i:${i}`}>
              <Icon name="quote" size={24} class="testimonial-card__quote-icon" />
              <p class="text-body-lg">{item.quote}</p>
              <p class="testimonial-card__name">{item.name}</p>
              <p class="text-small">{item.company} — {item.location}</p>
            </Card>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .testimonial-card__quote-icon {
    color: var(--color-primary-soft);
    margin-bottom: var(--space-4);
  }

  .testimonial-card__name {
    font: var(--weight-semibold) var(--text-base) var(--font-body);
    color: var(--color-text-primary);
    margin-top: var(--space-4);
  }
</style>
