---
/**
 * Identificação da dor (Section Map §25 #3). neutral-50, header centralizado + 4 PainCards.
 */
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { pain } = copy;
const ICONS = ['eye-off', 'layers', 'package-search', 'user-round-cog'];
---

<section id="pain" class="section section--alt" aria-labelledby="pain-heading">
  <div class="container">
    <div class="section-header section-header--center">
      <h2 id="pain-heading" class="text-h2 reveal">{pain.headline}</h2>
      <p class="text-body-lg reveal">{pain.intro}</p>
    </div>

    <div class="card-grid card-grid--4">
      {
        pain.cards.map((card, i) => (
          <Card variant="feature" class="reveal" style={`--i:${i}`}>
            <span class="pain-card__icon">
              <Icon name={ICONS[i]} size={24} />
            </span>
            <p class="text-h3">{card.title}</p>
            <p class="text-body">{card.text}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pain-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-box);
    height: var(--icon-box);
    border-radius: var(--radius-md);
    background: var(--color-icon-bg);
    color: var(--color-icon);
    margin-bottom: var(--space-5);
  }
</style>
