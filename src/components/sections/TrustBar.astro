---
/**
 * Barra de confiança (Section Map §25 #2). A fila de logos só renderiza
 * quando houver dados validados pela F5 — copy §7: "não inserir números
 * fictícios". Vazio hoje (design system: seções condicionais ocultas quando vazias).
 */
import Icon from '../ui/Icon.astro';
import copy from '../../content/copy/siofi-main.copy.json';

interface TrustLogo {
  src: string;
  alt: string;
}

const { trustBar } = copy;
const logos = trustBar.logos as TrustLogo[];
const hasLogos = logos.length > 0;
---

<section id="trust-bar" class="trust-bar">
  <div class="container trust-bar__inner">
    <span class="trust-bar__icon reveal" aria-hidden="true">
      <Icon name="shield-check" size={24} />
    </span>
    <p class="text-body-lg trust-bar__phrase reveal">{trustBar.phrase}</p>
    {
      hasLogos && (
        <div class="trust-bar__logos reveal">
          {logos.map((logo) => (
            <img src={logo.src} alt={logo.alt} width="96" height="32" loading="lazy" />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-16);
    background: linear-gradient(120deg, var(--color-primary-light) 0%, var(--color-white) 45%, var(--color-primary-light) 100%);
    border-top: 1px solid var(--color-primary-light-active);
    border-bottom: 1px solid var(--color-primary-light-active);
  }

  .trust-bar__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
    max-width: 680px;
    margin-inline: auto;
  }

  .trust-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-14);
    height: var(--space-14);
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-white);
    color: var(--color-primary);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--color-primary-light-active);
  }

  .trust-bar__phrase {
    font: var(--weight-bold) var(--text-lg)/var(--leading-heading) var(--font-display);
    letter-spacing: var(--tracking-heading);
    text-align: center;
    text-wrap: balance;
    max-width: 34ch;
    color: var(--color-primary-deep);
  }

  @media (max-width: 767px) {
    .trust-bar {
      padding-block: var(--space-12);
    }
  }

  .trust-bar__logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    filter: grayscale(1);
    opacity: 0.8;
  }
</style>
