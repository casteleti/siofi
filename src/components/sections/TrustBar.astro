---
/**
 * Barra de confiança (Section Map §25 #2). A fila de logos só renderiza
 * quando houver dados validados pela F5 — copy §7: "não inserir números
 * fictícios". Vazio hoje (design system: seções condicionais ocultas quando vazias).
 */
import Icon from '../ui/Icon.astro';
import copy from '../../content/copy/siofi-main.copy.json';

interface TrustLogo {
  src: string;
  alt: string;
}

const { trustBar } = copy;
const logos = trustBar.logos as TrustLogo[];
const hasLogos = logos.length > 0;
---

<section id="trust-bar" class="trust-bar">
  <div class="container trust-bar__inner">
    <span class="trust-bar__icon" aria-hidden="true">
      <Icon name="shield-check" size={20} />
    </span>
    <p class="text-body trust-bar__phrase reveal">{trustBar.phrase}</p>
    {
      hasLogos && (
        <div class="trust-bar__logos reveal">
          {logos.map((logo) => (
            <img src={logo.src} alt={logo.alt} width="96" height="32" loading="lazy" />
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-10);
    background: var(--color-surface-alt);
    border-block: 1px solid var(--color-border);
  }

  .trust-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .trust-bar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-icon-bg);
    color: var(--color-icon);
  }

  .trust-bar__phrase {
    text-align: center;
    font-weight: var(--weight-medium);
    color: var(--color-text-primary);
  }

  .trust-bar__logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-8);
    flex-wrap: wrap;
    margin-top: var(--space-6);
    filter: grayscale(1);
    opacity: 0.8;
  }
</style>
