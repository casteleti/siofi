---
/**
 * Barra de confiança (Section Map §25 #2). Logos/números condicionais —
 * ocultos até haver dados validados pela F5 (copy §7: não inventar números).
 */
---

<section id="trust-bar" class="trust-bar">
  <div class="container">
    <p class="text-body trust-bar__phrase reveal">
      Desenvolvido para a rotina de oficinas, auto centers e empresas do setor automotivo.
    </p>
    <div class="trust-bar__logos placeholder-block reveal" style="height: 32px;">
      [PLACEHOLDER — LogoStrip: logos/números condicionais, ocultos até dado validado pela F5]
    </div>
  </div>
</section>

<style>
  .trust-bar {
    padding-block: var(--space-12);
    background: var(--color-white);
    border-block: 1px solid var(--color-border);
  }

  .trust-bar__phrase {
    text-align: center;
    margin-bottom: var(--space-6);
  }
</style>
