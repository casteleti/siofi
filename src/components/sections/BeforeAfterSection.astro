---
/**
 * Antes × Com o SiOfi (Section Map §25 #9). Nunca uma <table> visual —
 * cards pareados (design system §17.2).
 */
import Icon from '../ui/Icon.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { beforeAfter } = copy;
---

<section id="before-after" class="section section--alt" aria-labelledby="before-after-heading">
  <div class="container">
    <div class="section-header section-header--center">
      <h2 id="before-after-heading" class="text-h2 reveal">{beforeAfter.headline}</h2>
    </div>

    <div class="before-after__list">
      {
        beforeAfter.pairs.map((pair, i) => (
          <div class="before-after__row reveal" style={`--i:${i}`}>
            <span class="before-after__item before-after__item--before">
              <span class="before-after__icon before-after__icon--before">
                <Icon name="minus" size={16} />
              </span>
              <span>{pair.before}</span>
            </span>

            <span class="before-after__arrow" aria-hidden="true">
              <Icon name="arrow-right" size={18} />
            </span>

            <span class="before-after__item before-after__item--after">
              <span class="before-after__icon before-after__icon--after">
                <Icon name="check" size={16} />
              </span>
              <span>{pair.after}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .before-after__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .before-after__row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xs);
    overflow: hidden;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .before-after__row:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-border-strong);
  }

  .before-after__item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
  }

  .before-after__item--before {
    color: var(--color-text-muted);
    background: linear-gradient(90deg, rgba(200, 52, 43, 0.05), rgba(200, 52, 43, 0));
  }

  .before-after__item--before span:last-child {
    text-decoration: line-through;
    text-decoration-color: var(--color-border-strong);
    text-decoration-thickness: 1.5px;
  }

  .before-after__item--after {
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    background: linear-gradient(90deg, rgba(30, 142, 90, 0.07), rgba(30, 142, 90, 0));
  }

  .before-after__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
  }

  .before-after__icon--before {
    background: var(--color-neutral-100);
    color: var(--color-text-muted);
  }

  .before-after__icon--after {
    background: rgba(30, 142, 90, 0.12);
    color: var(--color-success);
  }

  .before-after__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--color-icon-bg);
    color: var(--color-primary);
    justify-self: center;
    z-index: 1;
  }

  @media (max-width: 767px) {
    .before-after__row {
      grid-template-columns: 1fr;
      gap: 0;
      position: relative;
    }

    .before-after__item {
      padding: var(--space-4) var(--space-5);
    }

    /* FX-06: em vez de simplesmente sumir, a seta gira 90° e fica entre as
       duas linhas empilhadas — mantém o reforço visual de transformação
       sem precisar de texto novo (a copy não define um rótulo pra isso). */
    .before-after__arrow {
      margin-block: calc(var(--space-2) * -1);
      margin-inline: auto;
      transform: rotate(90deg);
      width: 28px;
      height: 28px;
      border: 3px solid var(--color-white);
    }
  }
</style>
