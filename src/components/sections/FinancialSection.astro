---
/**
 * Resultado financeiro (movimento 8 da reestruturação persuasiva). Base:
 * antiga Financeiro e resultados (Section Map §25 #7, id #financeiro) —
 * headline e copy preservados; id mantido de propósito (o header e o
 * scroll-spy já apontam para `#financeiro`).
 *
 * O `ProductFrame` de DRE que existia aqui não tinha `src` (nenhum
 * screenshot real de DRE no projeto — só indicadores.jpg e
 * ordem-de-servico.jpg em public/assets/screens/) e por isso renderizava o
 * texto `[PLACEHOLDER — screenshot: DRE...]` em produção. A regra global
 * desta reestruturação proíbe placeholder visível, então o bloco foi
 * removido e o espaço foi ocupado pelos 9 destaques (`financial.highlights`)
 * em um grid real, em vez de deixar a seção com uma coluna vazia.
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { financial } = copy;

const HIGHLIGHT_ICONS: Record<string, string> = {
  'Faturamento': 'trending-up',
  'Contas a pagar': 'upload',
  'Contas a receber': 'download',
  'Fluxo de caixa': 'activity',
  'DRE': 'file-text',
  'Balanço gerencial': 'scale',
  'Resultados do período': 'calendar-check',
  'Ticket médio': 'receipt-text',
  'Indicadores': 'bar-chart-3',
};
---

<section id="financeiro" class="section section--dark on-dark" aria-labelledby="financeiro-heading">
  <div class="container-wide split split--5-7">
    <div>
      <h2 id="financeiro-heading" class="text-h2 reveal">{financial.headline}</h2>
      {financial.paragraphs.map((paragraph) => <p class="text-body-lg reveal">{paragraph}</p>)}

      <p class="financial__support-phrase reveal">{financial.supportPhrase}</p>

      <div class="reveal">
        <Button variant="primary" href="#form" trackId="demo_cta_click" section="financeiro">
          {financial.cta}
        </Button>
      </div>
    </div>

    <ul class="financial__metrics reveal">
      {
        financial.highlights.map((label) => (
          <li>
            <span class="financial__metric-icon">
              <Icon name={HIGHLIGHT_ICONS[label] ?? 'bar-chart-3'} size={20} />
            </span>
            <span>{label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .financial__support-phrase {
    font: var(--weight-bold) 24px var(--font-display);
    color: var(--color-white);
    margin-bottom: var(--space-8);
  }

  .financial__metrics {
    list-style: none;
    margin: 0;
    padding: var(--space-8);
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5) var(--space-6);
    background: var(--color-surface-dark);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-xl);
  }

  .financial__metrics li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font: var(--weight-medium) var(--text-sm) var(--font-body);
    color: var(--color-text-on-dark);
  }

  .financial__metric-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-primary-soft);
  }

  @media (max-width: 767px) {
    .financial__metrics {
      grid-template-columns: 1fr;
      padding: var(--space-6);
    }
  }
</style>
