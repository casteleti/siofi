---
/**
 * Para quem é (Section Map §25 #10). Responsivo conforme a spec (§6 Grid /
 * §17.2 design system): 5 colunas no desktop → 3 colunas com as 2 últimas
 * centralizadas no tablet → carrossel horizontal com scroll-snap e
 * indicadores de posição no mobile (CARD-03/MOB-05: o grid genérico usado
 * antes deixava um card órfão no tablet, que não é o comportamento pedido).
 */
import Icon from '../ui/Icon.astro';
import Card from '../ui/Card.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { segments } = copy;
---

<section id="segments" class="section" aria-labelledby="segments-heading">
  <div class="container">
    <div class="section-header section-header--center">
      <h2 id="segments-heading" class="text-h2 reveal">{segments.headline}</h2>
    </div>

    <div class="segments-grid reveal" id="segments-grid">
      {
        segments.items.map((segment) => (
          <Card variant="feature" class="segments-grid__item">
            <span class="segment-card__icon">
              <Icon name={segment.icon} size={24} />
            </span>
            <h3 class="text-h3">{segment.name}</h3>
            <p class="text-body">{segment.text}</p>
          </Card>
        ))
      }
    </div>

    <div class="segments-dots" id="segments-dots" aria-hidden="true">
      {segments.items.map((_, i) => <span class="segments-dots__dot" data-index={i}></span>)}
    </div>

    {
      /* Banda de foto prevista pro design system p/ "Para quem é"
         (docs/siofi-landing-visual-design-system.md, ~linha 430), agora
         carregando o texto de qualificação dentro dela: antes eram dois
         blocos empilhados (card azul-claro + foto muda logo abaixo), o que
         repetia peso visual e deixava a foto sem função editorial. */
    }
    <div class="segments__band reveal">
      <img
        class="segments__band-bg"
        src="/assets/photos/oficina-parallax-03.webp"
        alt=""
        width="2560"
        height="888"
        loading="lazy"
        decoding="async"
      />
      <div class="segments__band-scrim" aria-hidden="true"></div>
      <p class="segments__band-text">{segments.qualifier}</p>
    </div>
  </div>
</section>

<style>
  .segment-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--icon-box);
    height: var(--icon-box);
    border-radius: var(--radius-md);
    background: var(--color-icon-bg);
    color: var(--color-icon);
    margin-bottom: var(--space-5);
  }

  .segments-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--gutter);
  }

  .segments-dots {
    display: none;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .segments-dots__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border-strong);
    transition: background-color var(--dur-fast) ease-out;
  }

  .segments-dots__dot.is-active {
    background: var(--color-primary);
  }

  /* Tablet: 3 colunas visuais, com os 2 últimos cards centralizados na
     segunda linha — grid de 6 faixas internas para permitir centralização
     exata (cada card "largo" ocupa 2 faixas). */
  @media (max-width: 1023px) and (min-width: 768px) {
    .segments-grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .segments-grid__item:nth-child(1) { grid-column: 1 / span 2; }
    .segments-grid__item:nth-child(2) { grid-column: 3 / span 2; }
    .segments-grid__item:nth-child(3) { grid-column: 5 / span 2; }
    .segments-grid__item:nth-child(4) { grid-column: 2 / span 2; }
    .segments-grid__item:nth-child(5) { grid-column: 4 / span 2; }
  }

  /* Mobile: carrossel horizontal com scroll-snap (§6/§17.2), não grid. */
  @media (max-width: 767px) {
    .segments-grid {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: var(--gutter-sm);
      margin-inline: calc(var(--page-px-sm) * -1);
      padding-inline: var(--page-px-sm);
      padding-bottom: var(--space-2);
      scrollbar-width: none;
    }

    .segments-grid::-webkit-scrollbar {
      display: none;
    }

    .segments-grid__item {
      flex: 0 0 260px;
      scroll-snap-align: start;
    }

    .segments-dots {
      display: flex;
    }
  }

  .segments__band {
    position: relative;
    isolation: isolate;
    margin-top: var(--space-16);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 21 / 9;
    /* Piso de altura: no mobile o 21:9 sozinho daria ~143px de altura, o que
       não comporta a frase; a partir daí a razão deixa de mandar e a altura
       passa a ser ditada pelo texto + padding. */
    min-height: 300px;
  }

  .segments__band-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* A foto já vem com o tratamento azul da marca, mas tem áreas claras
     (carros brancos, piso) onde texto branco sumiria — daí o véu extra,
     mais forte no centro, que é onde a frase fica. */
  .segments__band-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgba(8, 46, 99, 0.42) 0%, rgba(11, 61, 130, 0.55) 100%);
  }

  .segments__band-text {
    position: relative;
    z-index: 2;
    max-width: 820px;
    padding-inline: var(--space-8);
    text-align: center;
    text-wrap: balance;
    color: var(--color-white);
    font: var(--weight-semibold) var(--text-xl) / var(--leading-sub) var(--font-body);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 767px) {
    .segments__band {
      aspect-ratio: auto;
      min-height: 260px;
      padding-block: var(--space-10);
    }

    .segments__band-text {
      padding-inline: var(--space-5);
    }
  }
</style>

<script>
  // Indicadores de posição do carrossel mobile (§17.2) — só relevante
  // quando o layout vira flex/scroll (<768px), inofensivo nos demais.
  const grid = document.getElementById('segments-grid');
  const dots = Array.from(document.querySelectorAll('#segments-dots .segments-dots__dot'));

  if (grid && dots.length > 0) {
    const setActiveDot = () => {
      const firstItem = grid.querySelector('.segments-grid__item');
      if (!firstItem) return;
      const itemWidth = (firstItem as HTMLElement).offsetWidth + 12; // + gap aproximado
      const index = Math.round(grid.scrollLeft / itemWidth);
      dots.forEach((dot, i) => dot.classList.toggle('is-active', i === Math.min(index, dots.length - 1)));
    };

    setActiveDot();
    grid.addEventListener('scroll', setActiveDot, { passive: true });
  }
</script>
