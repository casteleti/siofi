---
/**
 * FAQ — parte 2 do movimento Objeções (Section Map §25 #14, id #faq).
 * Narrow 720px, <details>/<summary> nativo (zero JS, acessível por padrão —
 * spec técnica §12). Renderiza logo após SwitchingSection, mesmo fundo
 * `.section--alt`, sem dobra entre elas — as duas juntas formam o movimento
 * "Objeções" da reestruturação persuasiva.
 *
 * Reduzido de 12 para as 7 perguntas realmente decisórias (ver
 * `VISIBLE_FAQ_QUESTIONS`): as 5 removidas (placa, CPF/CNPJ, XML, painel do
 * cliente, WhatsApp) já foram bem explicadas no movimento Recursos — repeti-
 * las aqui só aumentaria volume sem agregar decisão. As 12 perguntas
 * aprovadas continuam intactas em copy.json; o array abaixo só seleciona
 * quais renderizam. `items` é passado por `index.astro`, que usa a MESMA
 * lista filtrada no `faqItems` do FAQPage JSON-LD — nunca há pergunta oculta
 * no schema que não apareça no accordion, nem vice-versa.
 */
import Icon from '../ui/Icon.astro';
import copy from '../../content/copy/siofi-main.copy.json';

interface Props {
  items?: typeof copy.faq.items;
}

const { faq } = copy;
const { items = faq.items } = Astro.props;
---

<section id="faq" class="section section--alt" aria-labelledby="faq-heading">
  <div class="container container-narrow">
    <div class="section-header section-header--center">
      <h2 id="faq-heading" class="text-h2 reveal">{faq.headline}</h2>
    </div>

    <div class="faq-accordion reveal">
      {
        items.map((item, i) => (
          <details class="faq-item" open={i === 0} data-track="faq_open" data-faq-question={item.question}>
            <summary class="faq-item__question">
              <h3 class="faq-item__question-text">{item.question}</h3>
              <Icon name="chevron-down" size={20} class="faq-item__chevron" />
            </summary>
            <div class="faq-item__answer">
              <p class="text-body">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-accordion {
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
  }

  .faq-item__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    cursor: pointer;
    font: var(--weight-semibold) 17px var(--font-body);
    color: var(--color-text-primary);
    list-style: none;
  }

  .faq-item__question::-webkit-details-marker {
    display: none;
  }

  /* Reset do <h3> — a pergunta é semanticamente um subtópico (§8 spec
     técnica), mas visualmente segue o mesmo tratamento do texto que tinha
     antes (herda peso/tamanho/cor de .faq-item__question). */
  .faq-item__question-text {
    margin: 0;
    font: inherit;
    color: inherit;
  }

  .faq-item__chevron {
    flex-shrink: 0;
    color: var(--color-secondary);
    transition: transform var(--dur-base) ease;
  }

  .faq-item[open] .faq-item__chevron {
    transform: rotate(180deg);
  }

  .faq-item__answer {
    padding-top: var(--space-3);
  }
</style>
