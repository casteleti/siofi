---
/**
 * CTA final + formulário (Section Map §25 #15, id #form). Segunda seção
 * primary-deep. Split 6/6, LeadForm em card branco (design system §12/§25).
 */
import LeadForm from '../form/LeadForm';
import copy from '../../content/copy/siofi-main.copy.json';

const { finalCta } = copy;
---

<section id="form" class="section section--dark on-dark" aria-labelledby="final-cta-heading">
  <div class="container-wide split split--6-6">
    <div>
      <h2 id="final-cta-heading" class="text-h2 reveal">{finalCta.headline}</h2>
      <p class="text-body-lg reveal">{finalCta.text}</p>
    </div>

    <div class="final-cta__form-card reveal">
      <LeadForm client:visible buttonLabel={finalCta.buttonLabel} microcopy={finalCta.microcopy} />
    </div>
  </div>
</section>

<style>
  .final-cta__form-card {
    background: var(--color-white);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
  }

  @media (max-width: 767px) {
    .final-cta__form-card {
      padding: var(--space-6);
    }
  }
</style>
