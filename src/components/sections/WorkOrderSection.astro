---
/**
 * Ordem de serviço (Section Map §25 #6, id #os). Timeline + split 5/7 com ProductFrame.
 */
import Button from '../ui/Button.astro';
import ProductFrame from '../ui/ProductFrame.astro';
import Callout from '../ui/Callout.astro';
import WorkOrderTimeline from '../ui/WorkOrderTimeline.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { workOrder } = copy;
---

<section id="os" class="section" aria-labelledby="os-heading">
  <div class="container">
    <div class="section-header">
      <h2 id="os-heading" class="text-h2 reveal">{workOrder.headline}</h2>
      {workOrder.paragraphs.map((paragraph) => <p class="text-body-lg reveal">{paragraph}</p>)}
    </div>

    <div class="work-order__timeline reveal">
      <WorkOrderTimeline />
    </div>

    <div class="split split--5-7">
      <div class="reveal">
        <Button variant="secondary" href="#os" trackId="secondary_cta_click" section="os" icon="play-circle" iconPosition="left">
          {workOrder.cta}
        </Button>
      </div>
      <div class="split__media reveal">
        <ProductFrame label="Ordem de serviço" ratio="16:10">
          Tela de ordem de serviço do SiOfi com cliente, veículo, peças e total
        </ProductFrame>
        <Callout icon="package" position="top-left">Peças e serviços</Callout>
        <Callout icon="file-text" position="bottom-right">Total</Callout>
      </div>
    </div>
  </div>
</section>

<style>
  .work-order__timeline {
    margin-bottom: var(--space-16);
  }

  .split__media {
    position: relative;
  }
</style>
