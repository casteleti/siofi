---
/**
 * Troca de sistema (Section Map §25 #11, neutral-50). Split 6/6, painel de
 * confiança + shield-check. Promessas de migração ficam pendentes (copy §16 TODO F5).
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';
import copy from '../../content/copy/siofi-main.copy.json';

const { switching } = copy;

/**
 * Rótulos curtos derivados do que a persona "Empresa trocando de sistema"
 * valoriza (copy §4) — não são frases novas de marketing nem promessa de
 * processo (isso segue pendente de validação da F5, copy §16 TODO F5).
 */
const TRUST_POINTS = [
  { icon: 'shield-check', label: 'Segurança e estabilidade' },
  { icon: 'route', label: 'Implantação organizada' },
  { icon: 'arrow-right-left', label: 'Confiança nos dados' },
];
---

<section id="switching" class="section section--alt" aria-labelledby="switching-heading">
  <div class="container split split--6-6">
    <div>
      <h2 id="switching-heading" class="text-h2 reveal">{switching.headline}</h2>
      <p class="text-sub text-sub--emphasis reveal">{switching.subheadline}</p>
      <p class="text-body reveal">{switching.text}</p>
      <div class="reveal">
        <Button variant="primary" href="#form?ctx=troca" trackId="demo_cta_click" section="troca_sistema">
          {switching.cta}
        </Button>
      </div>
    </div>

    <ul class="switching__points reveal">
      {
        TRUST_POINTS.map((point) => (
          <li>
            <Icon name={point.icon} size={20} />
            <span>{point.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .switching__points {
    list-style: none;
    margin: 0;
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .switching__points li {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
  }

  .switching__points li :global(svg) {
    flex-shrink: 0;
    display: inline-flex;
    width: var(--icon-box);
    height: var(--icon-box);
    padding: 10px;
    border-radius: var(--radius-full);
    background: var(--color-icon-bg);
    color: var(--color-icon);
    box-sizing: border-box;
  }
</style>
