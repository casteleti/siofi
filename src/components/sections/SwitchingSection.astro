---
/**
 * Troca de sistema (Section Map §25 #11, neutral-50). Split 6/6, painel de
 * confiança + shield-check. Promessas de migração ficam pendentes (copy §16 TODO F5).
 */
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

const TRUST_POINTS = [
  { icon: 'shield-check', label: 'Segurança e estabilidade' },
  { icon: 'arrow-right-left', label: 'Migração — [TBD F5: validar processo real]' },
  { icon: 'route', label: 'Acompanhamento durante a implantação' },
];
---

<section id="switching" class="section section--alt" aria-labelledby="switching-heading">
  <div class="container split split--6-6">
    <div>
      <h2 id="switching-heading" class="text-h2 reveal">
        [PLACEHOLDER — headline: Já usa outro sistema?]
      </h2>
      <p class="text-sub reveal" style="color: var(--color-text-primary); font-weight: var(--weight-medium);">
        [PLACEHOLDER — subheadline: Trocar de sistema precisa trazer mais controle — não mais problemas.]
      </p>
      <p class="text-body reveal">[PLACEHOLDER — texto da seção troca de sistema, Tarefa 2]</p>
      <div class="reveal">
        <Button variant="primary" href="#form" trackId="demo_cta_click">
          Quero avaliar o SiOfi
        </Button>
      </div>
    </div>

    <ul class="switching__points reveal">
      {
        TRUST_POINTS.map((point) => (
          <li>
            <Icon name={point.icon} size={20} />
            <span>{point.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .switching__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .switching__points li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
  }
</style>
