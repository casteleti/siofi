---
/**
 * Chip (design system §10.1/§12): usado em listas de recursos condensadas,
 * seleção "já usa sistema?" e chips de destaque em fundo escuro.
 */
interface Props {
  selected?: boolean;
  onDark?: boolean;
  as?: 'span' | 'button';
  class?: string;
}

const { selected = false, onDark = false, as = 'span', class: className } = Astro.props;
const Tag = as;
const classes = [
  'chip',
  selected ? 'chip--selected' : '',
  onDark ? 'chip--on-dark' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} aria-pressed={as === 'button' ? selected : undefined}>
  <slot />
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--btn-h-sm);
    padding: 0 var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border-strong);
    font: var(--weight-medium) var(--text-sm) var(--font-body);
    color: var(--color-text-secondary);
    background: var(--color-white);
  }

  .chip--selected {
    background: var(--color-primary-light);
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
    font-weight: var(--weight-medium);
  }

  .chip--on-dark {
    background: rgba(255, 255, 255, 0.08);
    border-color: var(--color-border-dark);
    color: var(--color-text-on-dark-secondary);
  }
</style>
