---
/**
 * Marcador de território para foto real ainda não recebida (pedido do
 * Renato em 2026-08-26: "quadrado vermelho, só pra marcar onde ficarão
 * essas imagens"). Propositalmente chamativo (hachura vermelha) — o
 * oposto do `.placeholder-block` neutro já usado no projeto — porque aqui
 * o objetivo é ficar impossível de confundir com conteúdo final enquanto
 * as fotos reais de oficina/mecânicos não chegam. Trocar por <img> real
 * (ou por <ProductFrame src=...> quando fizer sentido) assim que a foto
 * for entregue; não precisa alterar o layout ao redor.
 */
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}

const { label, ratio = '4 / 3', class: className } = Astro.props;
---

<div class:list={['image-placeholder', className]} style={`aspect-ratio: ${ratio};`}>
  <span class="image-placeholder__label">{label}</span>
</div>

<style>
  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 2px dashed rgba(255, 255, 255, 0.7);
    background-color: var(--color-error);
    background-image: repeating-linear-gradient(
      45deg,
      rgba(255, 255, 255, 0.12) 0,
      rgba(255, 255, 255, 0.12) 14px,
      transparent 14px,
      transparent 28px
    );
  }

  .image-placeholder__label {
    font: var(--weight-semibold) var(--text-sm) var(--font-body);
    color: var(--color-white);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    max-width: 28ch;
  }
</style>
