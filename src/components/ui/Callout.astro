---
/**
 * Pílula de callout sobre um ProductFrame (design system §15.1).
 * Até 3 por screenshot — é HTML, nunca parte da imagem.
 */
interface Props {
  icon?: string;
  /** Canto de ancoragem sobre o ProductFrame — as 4 combinações usadas no projeto. */
  position?: 'top-right' | 'top-left' | 'bottom-right' | 'bottom-left';
  class?: string;
}

import Icon from './Icon.astro';

const { icon, position = 'top-right', class: className } = Astro.props;
---

<span class={['callout', `callout--${position}`, className].filter(Boolean).join(' ')}>
  {icon && <Icon name={icon} size={16} />}
  <span><slot /></span>
</span>

<style>
  .callout {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-xs);
    padding: var(--space-2) var(--space-3);
    font: var(--weight-medium) var(--text-sm) var(--font-body);
    color: var(--color-primary);
  }

  .callout--top-right {
    top: calc(var(--space-4) * -1);
    right: var(--space-6);
  }

  .callout--top-left {
    top: calc(var(--space-4) * -1);
    left: var(--space-6);
  }

  .callout--bottom-right {
    bottom: calc(var(--space-4) * -1);
    right: var(--space-6);
  }

  .callout--bottom-left {
    bottom: calc(var(--space-4) * -1);
    left: var(--space-6);
  }
</style>
