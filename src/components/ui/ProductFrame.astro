---
/**
 * "Product Frame" (design system §15.1) — moldura própria que substitui a
 * barra de título original do SiOfi. Nesta tarefa não há screenshots reais
 * (ver README, checklist de assets §29.1 do design system); renderiza um
 * placeholder com as dimensões corretas para não gerar layout shift quando
 * a imagem real entrar na Tarefa 2/5.
 */
interface Props {
  label: string;
  ratio?: '16:10' | '16:9' | '4:3' | '4:5';
  size?: 'md' | 'lg';
  class?: string;
  src?: string;
  /** Dimensão real do arquivo em `src` (evita CLS — MUST §13 spec técnica). */
  width?: number;
  height?: number;
  /**
   * `eager` só no candidato a LCP (Hero); todo o resto é `lazy` por padrão
   * (auditoria SEO 2026-08-26 — antes vinha "eager" fixo pra qualquer
   * instância com `src`, inclusive fora da dobra inicial).
   */
  loading?: 'eager' | 'lazy';
}

const RATIO_MAP: Record<NonNullable<Props['ratio']>, string> = {
  '16:10': '16 / 10',
  '16:9': '16 / 9',
  '4:3': '4 / 3',
  '4:5': '4 / 5',
};

const {
  label,
  ratio = '16:10',
  size = 'md',
  class: className,
  src,
  width,
  height,
  loading = 'lazy',
} = Astro.props;
const aspectRatio = RATIO_MAP[ratio];
const webpSrc = src ? src.replace(/\.(jpg|jpeg|png)$/i, '.webp') : undefined;

// Texto alternativo real (spec técnica §14) — antes ia parar só na
// figcaption visualmente oculta, e o <img> em si nascia com alt="" mesmo
// sendo uma imagem de conteúdo (ruim pra Google Images e pra quem usa
// leitor de tela em navegadores que não associam figcaption como nome
// acessível). O slot continua existindo como fonte única do texto.
const altText = await Astro.slots.render('default');
---

<figure class={['product-frame', `product-frame--${size}`, className].filter(Boolean).join(' ')}>
  <div class="product-frame__bar">
    <span class="product-frame__dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
    <span class="product-frame__label">{label}</span>
  </div>
  <div class="product-frame__body" style={`aspect-ratio: ${aspectRatio};`}>
    {
      src ? (
        <picture>
          {webpSrc && <source srcset={webpSrc} type="image/webp" />}
          <img
            src={src}
            alt={altText}
            width={width}
            height={height}
            class="product-frame__img"
            loading={loading}
            fetchpriority={loading === 'eager' ? 'high' : 'auto'}
            decoding="async"
          />
        </picture>
      ) : (
        <p>[PLACEHOLDER — screenshot: {label}. Aguardando asset real da F5 (§29.1 design system).]</p>
      )
    }
  </div>
  <figcaption class="visually-hidden"><slot /></figcaption>
</figure>

<style>
  .product-frame {
    margin: 0;
    background: var(--color-white);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
  }

  .product-frame--lg {
    box-shadow: var(--shadow-lg);
  }

  /* FX-03: único efeito de destaque permitido pela spec (§16/§18 proíbem
     flutuação contínua e glow/gradiente atrás do card) — zoom sutil no
     hover (desktop) e no :active (toque), sem loop nem autoplay. */
  @media (hover: hover) {
    .product-frame:hover {
      transform: scale(1.02);
      box-shadow: var(--shadow-lg);
    }
  }

  .product-frame:active {
    transform: scale(1.01);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-frame {
      transition: none;
    }
    .product-frame:hover,
    .product-frame:active {
      transform: none;
    }
  }

  .product-frame__bar {
    height: var(--frame-bar-h);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-inline: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .product-frame__dots {
    display: inline-flex;
    gap: var(--space-2);
  }

  .product-frame__dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-neutral-300);
  }

  .product-frame__label {
    margin-inline-start: auto;
    font: var(--weight-regular) 12px var(--font-body);
    color: var(--color-text-muted);
  }

  .product-frame__body {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-neutral-100);
    color: var(--color-text-muted);
    font: var(--weight-regular) var(--text-sm) var(--font-body);
    padding: var(--space-4);
    text-align: center;
    overflow: hidden;
  }

  .product-frame__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
</style>
