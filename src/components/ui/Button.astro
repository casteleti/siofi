---
/**
 * Botão (design system §11). Variantes: primary, secondary, ghost.
 * `as="a"` para links de âncora/CTA; `as="button"` para submits de formulário.
 */
import Icon from './Icon.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  as?: 'a' | 'button';
  href?: string;
  type?: 'button' | 'submit';
  fullWidth?: boolean;
  icon?: string;
  iconPosition?: 'left' | 'right';
  onDark?: boolean;
  trackId?: string;
  class?: string;
}

const {
  variant = 'primary',
  as = 'a',
  href,
  type = 'button',
  fullWidth = false,
  icon,
  iconPosition = 'right',
  onDark = false,
  trackId,
  class: className,
} = Astro.props;

const Tag = as;
const classes = [
  'btn',
  `btn--${variant}`,
  onDark ? 'btn--on-dark' : '',
  fullWidth ? 'btn--full' : '',
  className,
]
  .filter(Boolean)
  .join(' ');
---

<Tag
  class={classes}
  href={as === 'a' ? href : undefined}
  type={as === 'button' ? type : undefined}
  data-track={trackId}
>
  {icon && iconPosition === 'left' && <Icon name={icon} size={20} />}
  <span class="btn__label"><slot /></span>
  {icon && iconPosition === 'right' && <Icon name={icon} size={20} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--btn-h);
    padding: 0 var(--btn-px);
    border-radius: var(--radius-sm);
    font: var(--weight-semibold) var(--text-base) var(--font-body);
    letter-spacing: var(--tracking-button);
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition:
      background-color var(--dur-fast) ease-out,
      transform var(--dur-fast) ease-out,
      box-shadow var(--dur-fast) ease-out;
  }

  .btn--primary {
    background: var(--color-primary);
    color: var(--color-white);
  }

  .btn--primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
    box-shadow: var(--shadow-sm);
  }

  .btn--primary:active {
    background: var(--color-primary-deep);
    transform: translateY(0);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
  }

  .btn--secondary:hover {
    background: var(--color-primary-light);
  }

  .btn--ghost {
    height: var(--btn-h-sm);
    padding: 0 var(--space-2);
    background: transparent;
    color: var(--color-primary);
  }

  .btn--ghost:hover {
    text-decoration: underline;
  }

  .btn--on-dark.btn--secondary {
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .btn--on-dark.btn--secondary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .btn--full {
    width: 100%;
  }
</style>
