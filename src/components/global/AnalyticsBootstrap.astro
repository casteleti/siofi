---
/**
 * Bootstrap de tracking client-side (spec técnica §12/§25/§37 + design system
 * §30.13): Consent Mode default, GTM loader condicional, captura de
 * atribuição, delegação de cliques `[data-track]`, scroll depth e FAQ open.
 *
 * Não faz parte do Claude Code Implementation Map (§68) como arquivo nomeado
 * — é a peça de infraestrutura que liga os stubs de `/lib/analytics` e
 * `/lib/tracking` (Tarefa 1) ao DOM real (Tarefa 3).
 */
const gtmContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
const hasValidGtmId = typeof gtmContainerId === 'string' && /^GTM-[A-Z0-9]+$/.test(gtmContainerId);

const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '2344577213019896';
const hasValidMetaPixelId = typeof metaPixelId === 'string' && /^\d+$/.test(metaPixelId);
---

{
  hasValidGtmId && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      />
    </noscript>
  )
}

{
  hasValidMetaPixelId && (
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${metaPixelId}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  )
}

<script>
  import { applyDefaultConsent, getStoredConsent } from '../../lib/tracking/consent';
  import { captureAttributionFromUrl } from '../../lib/tracking/attribution';
  import {
    trackCtaClick,
    trackWhatsappClick,
    trackPhoneClick,
    trackScrollDepth,
    trackFaqOpen,
    type WhatsappClickLocation,
  } from '../../lib/analytics/dataLayer';

  // Consent Mode default (MUST antes de GTM/GA4) + atribuição — independem de GTM/GA4 configurados.
  applyDefaultConsent();
  captureAttributionFromUrl();

  const gtmContainerId = import.meta.env.PUBLIC_GTM_CONTAINER_ID;
  const hasValidGtmId = typeof gtmContainerId === 'string' && /^GTM-[A-Z0-9]+$/.test(gtmContainerId);

  if (hasValidGtmId) {
    (function (w: any, d: Document, s: string, l: string, i: string) {
      w[l] = w[l] || [];
      w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      const f = d.getElementsByTagName(s)[0];
      const j = d.createElement(s) as HTMLScriptElement;
      const dl = l !== 'dataLayer' ? '&l=' + l : '';
      j.async = true;
      j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
      f.parentNode?.insertBefore(j, f);
    })(window, document, 'script', 'dataLayer', gtmContainerId);
  }

  // Tag direta do GA4 (fora do GTM) — ID fornecido em 2026-09-22, com fallback
  // hardcoded no mesmo padrão de PUBLIC_SITE_URL (astro.config.mjs), já que o
  // Dockerfile não repassa PUBLIC_* como build arg para o `npm run build`.
  // Carregada depois de applyDefaultConsent() para respeitar o Consent Mode v2:
  // window.gtag já existe como stub que só enfileira em dataLayer até o
  // gtag.js real (abaixo) processar a fila, então os 4 sinais continuam
  // "denied" até o usuário aceitar no banner.
  const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID || 'G-7H5MLNCYHJ';
  const hasValidGa4Id = typeof ga4MeasurementId === 'string' && /^G-[A-Z0-9]+$/.test(ga4MeasurementId);

  if (hasValidGa4Id) {
    const gaScript = document.createElement('script');
    gaScript.async = true;
    gaScript.src = `https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`;
    document.head.appendChild(gaScript);
    window.gtag('js', new Date());
    window.gtag('config', ga4MeasurementId);
  }

  // Meta Pixel — ID fornecido em 2026-09-22, mesmo fallback hardcoded dos
  // blocos acima. O Pixel tem seu próprio mecanismo de consentimento
  // (fbq('consent', 'grant'|'revoke')), independente do Google Consent Mode:
  // inicializa em "revoke" (nenhum cookie/dado coletado) a menos que já haja
  // escolha salva com analytics_and_ads=true; setConsentChoice() em consent.ts
  // atualiza esse estado quando o usuário interage com o banner depois.
  const metaPixelId = import.meta.env.PUBLIC_META_PIXEL_ID || '2344577213019896';
  const hasValidMetaPixelId = typeof metaPixelId === 'string' && /^\d+$/.test(metaPixelId);

  if (hasValidMetaPixelId) {
    (function (f: any, b: Document, e: string, v: string, n?: any, t?: any, s?: any) {
      if (f.fbq) return;
      n = f.fbq = function (...args: unknown[]) {
        n.callMethod ? n.callMethod.apply(n, args) : n.queue.push(args);
      };
      if (!f._fbq) f._fbq = n;
      n.push = n;
      n.loaded = true;
      n.version = '2.0';
      n.queue = [];
      t = b.createElement(e) as HTMLScriptElement;
      t.async = true;
      t.src = v;
      s = b.getElementsByTagName(e)[0];
      s.parentNode?.insertBefore(t, s);
    })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

    // window.fbq está garantido pela IIFE acima (define-o incondicionalmente).
    window.fbq!('consent', getStoredConsent()?.analytics_and_ads ? 'grant' : 'revoke');
    window.fbq!('init', metaPixelId);
    window.fbq!('track', 'PageView');
  }

  const CTA_EVENTS = new Set(['hero_cta_click', 'demo_cta_click', 'secondary_cta_click']);

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const trackedEl = target.closest('[data-track]');
    if (!trackedEl) return;

    const track = trackedEl.getAttribute('data-track');
    const section = trackedEl.getAttribute('data-section') ?? undefined;
    const label = trackedEl.textContent?.trim();
    if (!track) return;

    if (CTA_EVENTS.has(track)) {
      trackCtaClick(track as 'hero_cta_click' | 'demo_cta_click' | 'secondary_cta_click', section, label);
      return;
    }

    if (track === 'whatsapp_click') {
      trackWhatsappClick((section as WhatsappClickLocation) ?? 'floating_button');
      return;
    }

    if (track === 'phone_click') {
      trackPhoneClick(section ?? 'unknown');
    }
  });

  // FAQ open (§22): dispara quando um <details> marcado é aberto pelo usuário.
  document.addEventListener(
    'toggle',
    (event) => {
      const details = event.target;
      if (!(details instanceof HTMLDetailsElement)) return;
      if (!details.open || details.dataset.track !== 'faq_open') return;
      const question = details.dataset.faqQuestion;
      if (question) trackFaqOpen(question);
    },
    true,
  );

  // Scroll depth (25/50/75/100%, uma vez por carregamento de página).
  const firedMilestones = new Set<number>();
  const MILESTONES = [25, 50, 75, 100] as const;

  function computeScrollPercentage(): number {
    const doc = document.documentElement;
    const scrollable = doc.scrollHeight - doc.clientHeight;
    if (scrollable <= 0) return 100;
    return Math.min(100, Math.round((window.scrollY / scrollable) * 100));
  }

  let ticking = false;
  window.addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const percentage = computeScrollPercentage();
        for (const milestone of MILESTONES) {
          if (percentage >= milestone && !firedMilestones.has(milestone)) {
            firedMilestones.add(milestone);
            trackScrollDepth(milestone);
          }
        }
        ticking = false;
      });
    },
    { passive: true },
  );
</script>
