---
/**
 * Banner de consentimento (spec técnica §38, MUST). Duas categorias
 * independentes: "Necessários" (sempre ativo) e "Analytics e Publicidade"
 * (opt-in, desativado por padrão). Não bloqueia o uso da página por trás dele.
 *
 * Componente novo, fora do Claude Code Implementation Map (§68) — a LGPD/
 * Consent Mode v2 (§38, MUST) exige essa peça de UI que a Tarefa 1 não previu
 * como arquivo nomeado.
 */
import Button from '../ui/Button.astro';
---

<div id="consent-banner" class="consent-banner" role="dialog" aria-labelledby="consent-banner-title" aria-describedby="consent-banner-text" hidden>
  <div class="consent-banner__inner">
    <div class="consent-banner__copy">
      <p id="consent-banner-title" class="text-h3">Usamos cookies</p>
      <p id="consent-banner-text" class="text-small">
        Usamos cookies necessários para o funcionamento do site e, com sua permissão, cookies de
        analytics e publicidade para entender como a página é usada. Veja nossa
        <a href="[TBD — URL POLÍTICA DE PRIVACIDADE]">política de privacidade</a>.
      </p>
      <label class="consent-banner__checkbox">
        <input type="checkbox" id="consent-analytics-ads" />
        <span>Analytics e publicidade (opcional)</span>
      </label>
    </div>
    <div class="consent-banner__actions">
      <Button as="button" variant="secondary" id="consent-save">Salvar preferências</Button>
      <Button as="button" variant="primary" id="consent-accept-all">Aceitar todos</Button>
    </div>
  </div>
</div>

<style>
  .consent-banner {
    position: fixed;
    left: var(--space-4);
    right: var(--space-4);
    bottom: var(--space-4);
    z-index: 90;
    max-width: 640px;
    margin-inline: auto;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
  }

  .consent-banner[hidden] {
    display: none;
  }

  .consent-banner__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .consent-banner__checkbox {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: var(--weight-medium) var(--text-sm) var(--font-body);
    color: var(--color-text-primary);
  }

  .consent-banner__actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
  }

  @media (max-width: 767px) {
    .consent-banner__actions {
      flex-direction: column-reverse;
    }

    .consent-banner__actions :global(.btn) {
      width: 100%;
    }
  }
</style>

<script>
  import { hasStoredConsentChoice, setConsentChoice } from '../../lib/tracking/consent';

  const banner = document.getElementById('consent-banner');
  const checkbox = document.getElementById('consent-analytics-ads') as HTMLInputElement | null;
  const saveBtn = document.getElementById('consent-save');
  const acceptAllBtn = document.getElementById('consent-accept-all');

  if (banner && !hasStoredConsentChoice()) {
    banner.hidden = false;
  }

  function hideBanner() {
    if (banner) banner.hidden = true;
  }

  saveBtn?.addEventListener('click', () => {
    setConsentChoice({ analytics_and_ads: checkbox?.checked ?? false });
    hideBanner();
  });

  acceptAllBtn?.addEventListener('click', () => {
    if (checkbox) checkbox.checked = true;
    setConsentChoice({ analytics_and_ads: true });
    hideBanner();
  });
</script>
