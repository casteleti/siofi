---
/**
 * Footer (copy §22 / design system §25): fundo primary-deep, logo negativo,
 * contatos, links legais. WhatsApp e CNPJ ainda não fornecidos pela F5.
 */
import { getWhatsappHref, hasWhatsappNumber } from '../../lib/whatsapp';
import { CONTACT, CITY_STATE } from '../../lib/contact';
const whatsappHref = getWhatsappHref();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      {/* [PLACEHOLDER — logo negativo SVG do SiOfi, pendente da F5 §29.1] */}
      <p class="logo-wordmark logo-wordmark--on-dark footer__logo">SiOfi</p>
      <p class="footer__tagline">Software de gestão para o setor automotivo</p>
    </div>

    <nav class="footer__nav" aria-label="Links rápidos">
      <p class="footer__col-title">Recursos</p>
      <ul>
        <li><a href="#pilares">Pilares</a></li>
        <li><a href="#os">Ordem de serviço</a></li>
        <li><a href="#financeiro">Financeiro</a></li>
        <li><a href="#faq">Dúvidas</a></li>
      </ul>
    </nav>

    <div class="footer__contact">
      <p class="footer__col-title">Contato</p>
      <p>
        Telefone: <a href={CONTACT.phone.href} data-track="phone_click" data-section="footer">{CONTACT.phone.display}</a>
      </p>
      <p>
        WhatsApp:{' '}
        {hasWhatsappNumber() ? (
          <a href={whatsappHref} target="_blank" rel="noopener" data-track="whatsapp_click" data-section="footer_link">
            Falar no WhatsApp
          </a>
        ) : (
          '[TBD — WHATSAPP F5]'
        )}
      </p>
      <p>E-mail: <a href={`mailto:${CONTACT.emails.contact}`}>{CONTACT.emails.contact}</a></p>
      <p>{CITY_STATE}</p>
    </div>

    <div class="footer__legal">
      <p class="footer__col-title">Legal</p>
      <a href="[TBD — URL POLÍTICA DE PRIVACIDADE]">Política de privacidade</a>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>© {new Date().getFullYear()} F5 Software de Gestão. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-dark);
    color: var(--color-text-on-dark-secondary);
    padding-block: 64px var(--space-8);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-8);
  }

  .footer__logo {
    margin-bottom: var(--space-2);
  }

  .footer__tagline {
    font-size: var(--text-sm);
    color: var(--color-text-on-dark-secondary);
    max-width: 220px;
  }

  .footer__col-title {
    font: var(--weight-semibold) var(--text-xs) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-primary-soft);
    margin-bottom: var(--space-4);
  }

  .footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer p {
    margin: 0 0 var(--space-1);
  }

  .footer__contact p {
    margin: 0 0 var(--space-3);
  }

  .footer a {
    color: var(--color-white);
    text-decoration: none;
  }

  .footer a:hover {
    text-decoration: underline;
  }

  .footer__legal {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__bottom {
    margin-top: var(--space-12);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-dark);
    font-size: var(--text-sm);
  }

  @media (max-width: 767px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>
