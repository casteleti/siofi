---
/**
 * Header sticky (design system §17.2/§25). Logo flat + nav + CTA no desktop;
 * logo + CTA compacto + botão de menu no mobile (abre MobileDrawer).
 */
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import MobileDrawer from './MobileDrawer.astro';

const NAV_LINKS = [
  { href: '#pilares', label: 'Pilares' },
  { href: '#os', label: 'Ordem de serviço' },
  { href: '#financeiro', label: 'Financeiro' },
  { href: '#faq', label: 'Dúvidas' },
];
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/siofi" class="header__logo" aria-label="SiOfi — página inicial">
      <img src="/assets/logo/logo-siofi.png" alt="SiOfi" width="128" height="43" class="header__logo-img" />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul>
        {NAV_LINKS.map((link) => (
          <li><a href={link.href} data-nav-link={link.href.slice(1)}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <Button variant="primary" size="sm" href="#form" trackId="demo_cta_click" section="header" class="header__cta">
        Agendar uma demonstração
      </Button>
      <button
        type="button"
        id="drawer-toggle"
        class="header__menu-btn"
        aria-expanded="false"
        aria-controls="mobile-drawer"
        aria-label="Abrir menu"
      >
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<MobileDrawer links={NAV_LINKS} />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: var(--color-white);
    border-bottom: 1px solid transparent;
    transition: box-shadow var(--dur-base) ease-out, height var(--dur-base) ease-out;
  }

  .header.is-scrolled {
    box-shadow: var(--shadow-xs);
    border-bottom-color: var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    width: 100%;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .header__logo-img {
    display: block;
    height: 32px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__nav a {
    position: relative;
    font: var(--weight-medium) 15px var(--font-body);
    color: var(--color-text-primary);
    text-decoration: none;
    padding-bottom: 2px;
  }

  /* FX-04: sublinhado animado — cresce da esquerda no hover/foco, fica fixo
     enquanto a seção correspondente está visível (.is-active). */
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .header__nav a:hover::after,
  .header__nav a:focus-visible::after,
  .header__nav a.is-active::after {
    transform: scaleX(1);
  }

  .header__nav a.is-active {
    color: var(--color-primary-dark);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header__menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: var(--touch-min);
    height: var(--touch-min);
    background: transparent;
    border: none;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  @media (max-width: 1023px) {
    .header {
      height: var(--header-h-sm);
    }

    .header__nav {
      display: none;
    }

    .header__cta {
      display: none;
    }

    .header__menu-btn {
      display: inline-flex;
    }

    .header__logo-img {
      height: 28px;
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');

  const updateScrolledState = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 24);
  };

  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });

  // FX-04: scroll-spy simples — marca o link correspondente à seção mais
  // visível no momento (nenhum valor do design system é afetado por isso).
  const navLinks = document.querySelectorAll('[data-nav-link]');
  if (navLinks.length > 0 && 'IntersectionObserver' in window) {
    const sectionIds = Array.from(navLinks).map((link) => link.getAttribute('data-nav-link'));
    const sections = sectionIds
      .map((id) => (id ? document.getElementById(id) : null))
      .filter((el) => el !== null);

    const setActive = (id: string) => {
      navLinks.forEach((link) => {
        link.classList.toggle('is-active', link.getAttribute('data-nav-link') === id);
      });
    };

    const spy = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting);
        if (visible.length === 0) return;
        const topMost = visible.reduce((a, b) => (a.boundingClientRect.top < b.boundingClientRect.top ? a : b));
        setActive(topMost.target.id);
      },
      { rootMargin: '-40% 0px -50% 0px', threshold: 0 },
    );

    sections.forEach((section) => spy.observe(section));
  }
</script>
