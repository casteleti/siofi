---
/**
 * Layout base — casca HTML comum a todas as páginas (§6/§7/§9 da spec técnica).
 * Não faz parte do Claude Code Implementation Map (§68) como arquivo nomeado,
 * mas é infraestrutura necessária para não duplicar <html>/<head> em cada página.
 */
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import FloatingWhatsApp from '../components/global/FloatingWhatsApp.astro';
import StickyMobileCTA from '../components/global/StickyMobileCTA.astro';
import AnalyticsBootstrap from '../components/global/AnalyticsBootstrap.astro';
import ConsentBanner from '../components/global/ConsentBanner.astro';
import organizationSchema from '../schemas/organization.json';
import { buildSoftwareApplicationSchema } from '../schemas/software-application';
import { buildFaqPageSchema, type FaqItem } from '../schemas/faq-page';

interface Props {
  title: string;
  description: string;
  canonical: string;
  indexable?: boolean;
  includeSoftwareApplicationSchema?: boolean;
  faqItems?: FaqItem[];
}

const {
  title,
  description,
  canonical,
  indexable = true,
  includeSoftwareApplicationSchema = false,
  faqItems = [],
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonicalUrl = `${siteUrl}${canonical}`;
const robotsContent = indexable ? 'index, follow' : 'noindex, follow';

const softwareApplicationSchema = includeSoftwareApplicationSchema
  ? buildSoftwareApplicationSchema(siteUrl)
  : null;
const faqPageSchema = buildFaqPageSchema(faqItems);
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    {/* [PLACEHOLDER — og:image, pendente de asset real §29 design system] */}

    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    {/*
      Fonte real via Google Fonts CDN — alternativa explicitamente aceita pela
      spec técnica (§15: "alternativa aceitável... Google Fonts CDN com
      preconnect, se a equipe preferir não gerenciar os arquivos") enquanto os
      arquivos self-hosted (public/fonts/*.woff2) não são fornecidos pela F5.
      Sem isso, a página inteira renderiza em fonte de sistema (fallback) —
      efeito visual "genérico" que nenhum ajuste de token resolve sozinho.
      Os @font-face self-hosted em global.css continuam declarados e assumem
      o lugar automaticamente assim que os arquivos reais existirem.
    */}
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@700;800&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} is:inline />
    {
      softwareApplicationSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(softwareApplicationSchema)} is:inline />
      )
    }
    {
      faqPageSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} is:inline />
      )
    }

    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir para o conteúdo</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />
    <StickyMobileCTA />
    <ConsentBanner />
    <AnalyticsBootstrap />

    <script>
      // IntersectionObserver único para animações .reveal (§18 design system).
      const revealTargets = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && revealTargets.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          // FX-02: rootMargin positivo antecipa o disparo em ~300px antes do
          // elemento entrar na viewport — evita título/CTA em branco por mais
          // de uma fração de segundo durante rolagem rápida.
          { threshold: 0.05, rootMargin: '0px 0px 300px 0px' },
        );
        revealTargets.forEach((el) => observer.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
