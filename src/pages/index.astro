---
/**
 * Página principal /siofi (spec técnica §4: versão canônica do produto).
 *
 * Reestruturação persuasiva (ver relatório): as antigas 18 seções viraram
 * 11 movimentos — Hero, Especialização, Dor, Solução, Transformação,
 * Recursos, Produto na prática, Resultado financeiro, Confiança, Objeções
 * (Troca de sistema + FAQ) e CTA final. Ritmo: Dor → Solução →
 * Transformação → Recursos → Produto → Resultado → Confiança → Objeções →
 * Conversão, evitando a sequência feature → feature → feature do layout
 * anterior.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

import Hero from '../components/sections/Hero.astro';
import TrustBar from '../components/sections/TrustBar.astro';
import PainSection from '../components/sections/PainSection.astro';
import ValueProposition from '../components/sections/ValueProposition.astro';
import BeforeAfterSection from '../components/sections/BeforeAfterSection.astro';
import ResourcesSection from '../components/sections/ResourcesSection.astro';
import WorkOrderSection from '../components/sections/WorkOrderSection.astro';
import FinancialSection from '../components/sections/FinancialSection.astro';
import TrustSection from '../components/sections/TrustSection.astro';
import SwitchingSection from '../components/sections/SwitchingSection.astro';
import TestimonialsSection from '../components/sections/TestimonialsSection.astro';
import FAQSection from '../components/sections/FAQSection.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import copy from '../content/copy/siofi-main.copy.json';

// Nota: o campo `slug` no JSON é tratado pelo glob loader do Astro como
// override do id da entrada — por isso o id real é "siofi" (valor de `slug`),
// não "siofi-main" (nome do arquivo).
const entry = await getEntry('landing-pages', 'siofi');
if (!entry) {
  throw new Error('Content collection entry "siofi" não encontrada em src/content/landing-pages.');
}
const page = entry.data;

/**
 * FAQ reduzido às 7 perguntas decisórias do movimento Objeções (ver
 * FAQSection.astro). Filtrado aqui — não em copy.json, que continua com as
 * 12 aprovadas — para garantir que o accordion e o FAQPage JSON-LD (schema
 * abaixo) usem exatamente a mesma lista, sem pergunta oculta em um e visível
 * no outro.
 */
const VISIBLE_FAQ_QUESTIONS = [
  'Para quais empresas o SiOfi é indicado?',
  'O SiOfi possui ordem de serviço?',
  'O SiOfi ajuda no controle financeiro?',
  'O sistema controla estoque?',
  'O SiOfi emite nota fiscal?',
  'Posso conhecer o sistema antes de contratar?',
  'Como funciona o suporte?',
];
const visibleFaqItems = copy.faq.items.filter((item) => VISIBLE_FAQ_QUESTIONS.includes(item.question));
---

<BaseLayout
  title={page.metaTitle}
  description={page.metaDescription}
  canonical={page.canonical}
  indexable={page.indexable}
  includeSoftwareApplicationSchema
  faqItems={visibleFaqItems}
>
  <Hero h1={page.h1} />
  <TrustBar />
  <PainSection />
  <ValueProposition />
  <BeforeAfterSection />
  <ResourcesSection />
  <WorkOrderSection />
  <FinancialSection />
  <TrustSection />
  <SwitchingSection />
  <TestimonialsSection />
  <FAQSection items={visibleFaqItems} />
  <FinalCTA />
</BaseLayout>
